<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (Android 8.0+).
  Background: the artwork's gradient, as a vector.
  Foreground: the artwork's white shapes, extracted by tools/GenerateIcons.java and
  scaled to sit inside the central 66 x 66 dp safe area.
  Monochrome: the same shapes as a white silhouette, so a themed launcher can
  recolour the icon while keeping its outline.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
